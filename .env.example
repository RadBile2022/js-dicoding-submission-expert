# Forum API production example (NGINX proxies to 127.0.0.1:3000)
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# PostgreSQL on the same VM
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=forumapi
PGDATABASE=forumapi
PGPASSWORD=CHANGE_WITH_A_STRONG_PASSWORD

# Generate long random values for production. Never commit the real values.
ACCESS_TOKEN_KEY=CHANGE_WITH_A_LONG_RANDOM_VALUE
REFRESH_TOKEN_KEY=CHANGE_WITH_A_DIFFERENT_LONG_RANDOM_VALUE
ACCESS_TOKEN_AGE=3000
